GEMINI_API_KEY=your_gemini_api_key_here

# Environment (development | staging | production)
ENV=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Auth
# SUPABASE_URL is used to auto-fetch the JWKS for ES256/RS256 tokens (newer Supabase projects)
SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_JWT_SECRET: Only needed for legacy HS256 tokens.
# Get this from: Supabase Dashboard → Project Settings → API → JWT Secret
# IMPORTANT: This must be the signing secret, NOT the anon key or service role key.
# Using the anon key here allows anyone to forge authentication tokens.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Get this from: Supabase Dashboard → Project Settings → API → service_role key
# NEVER expose this in the frontend — it bypasses RLS.
# Auth is enforced by default. Set False only for local dev without Supabase.
REQUIRE_AUTH=False
