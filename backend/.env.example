GEMINI_API_KEY=your_gemini_api_key_here

# Environment (development | staging | production)
ENV=development

# CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Auth
# SUPABASE_URL is used to auto-fetch the JWKS for ES256/RS256 tokens (newer Supabase projects)
SUPABASE_URL=https://yourproject.supabase.co
# SUPABASE_JWT_SECRET is only needed for legacy HS256 tokens
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
# Auth is enforced by default. Set False only for local dev without Supabase.
REQUIRE_AUTH=False
